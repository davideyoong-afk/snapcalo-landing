type MealTag = 'breakfast' | 'lunch' | 'dinner'

interface Meal {
  id: string
  emoji: string
  name: string
  baseKcal: number
  servings: number
  tag: MealTag
  dishId?: string
}

interface SnapItem {
  id: string
  emoji: string
  name: string
