  servings: number
  conf: number
  dishId?: string
}

interface MacroVals {
  carbs: number
  protein: number
  fat: number
}

const uid = () => Math.random().toString(36).slice(2, 9)
const clampServings = (v: number) => Math.min(3, Math.max(0.5, Math.round(v * 2) / 2))
const macrosOf = (kcal: number): MacroVals => ({
  carbs: Math.round((kcal * 0.5) / 4),
  protein: Math.round((kcal * 0.2) / 4),
  fat: Math.round((kcal * 0.3) / 9),
})

/** SnapCalo engine: dishId + servings → real USDA-backed computation */
const engineOf = (m: { dishId?: string; servings: number }) => {
  const dish = m.dishId ? DISHES.find((d) => d.id === m.dishId) : undefined
  return dish ? computeMeal(dish, dish.refGrams * m.servings) : null
}
const kcalOf = (m: { baseKcal: number; servings: number; dishId?: string }) => {
  const e = engineOf(m)
  return e ? Math.round(e.total.kcal) : Math.round(m.baseKcal * m.servings)
}
const macrosOfMeal = (m: { baseKcal: number; servings: number; dishId?: string }): MacroVals => {
  const e = engineOf(m)
  return e
    ? {
        carbs: Math.round(e.total.carbs),
        protein: Math.round(e.total.protein),
        fat: Math.round(e.total.fat),
      }
    : macrosOf(kcalOf(m))
}
const sumMacros = (ms: { baseKcal: number; servings: number; dishId?: string }[]): MacroVals =>
  ms.reduce<MacroVals>(
    (acc, m) => {
      const x = macrosOfMeal(m)
      return { carbs: acc.carbs + x.carbs, protein: acc.protein + x.protein, fat: acc.fat + x.fat }
    },
    { carbs: 0, protein: 0, fat: 0 },
  )

interface MicroVals {
  sugar: number
  sodium: number
  fiber: number
}

/** Engine-backed sugar/sodium/fiber; kcal-based rough estimate for free-text meals */
const microsOfMeal = (m: { baseKcal: number; servings: number; dishId?: string }): MicroVals => {
  const e = engineOf(m)
  if (e) return { sugar: e.total.sugar ?? 0, sodium: e.total.sodium ?? 0, fiber: e.total.fiber ?? 0 }
  const k = kcalOf(m)
  return { sugar: k * 0.02, sodium: k * 1.0, fiber: k * 0.006 }
}
const sumMicros = (ms: { baseKcal: number; servings: number; dishId?: string }[]): MicroVals =>
  ms.reduce<MicroVals>(
    (acc, m) => {
      const x = microsOfMeal(m)
      return { sugar: acc.sugar + x.sugar, sodium: acc.sodium + x.sodium, fiber: acc.fiber + x.fiber }
    },
    { sugar: 0, sodium: 0, fiber: 0 },
  )

/** WHO-aligned daily references: sugar <50 g, sodium <2000 mg (limits); fiber ≥25 g (goal) */
const MICRO_REFS = { sugar: 50, sodium: 2000, fiber: 25 }

const GOAL_TARGETS: Record<Goal, number> = { lose: 1800, maintain: 2100, gain: 2400 }

