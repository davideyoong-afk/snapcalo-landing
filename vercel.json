{
  "rewrites": [
    {
      "source": "/",
      "destination": "/prerender/home.html"
    },
    {
      "source": "/blog",
      "destination": "/prerender/blog.html"
    },
    {
      "source": "/blog/kopitiam-drinks-calories",
      "destination": "/prerender/blog/kopitiam-drinks-calories.html"
    },
    {
      "source": "/blog/nasi-lemak-calories",
      "destination": "/prerender/blog/nasi-lemak-calories.html"
    },
    {
      "source": "/blog/sea-food-calories-ranked",
      "destination": "/prerender/blog/sea-food-calories-ranked.html"
    },
    {
      "source": "/blog/suku-suku-separuh-guide",
      "destination": "/prerender/blog/suku-suku-separuh-guide.html"
    },
    {
      "source": "/blog/how-ai-calorie-tracking-works",
      "destination": "/prerender/blog/how-ai-calorie-tracking-works.html"
    },
    {
      "source": "/blog/lose-weight-without-giving-up-hawker-food",
      "destination": "/prerender/blog/lose-weight-without-giving-up-hawker-food.html"
    },
    {
      "source": "/blog/viral-tiktok-food-calories",
      "destination": "/prerender/blog/viral-tiktok-food-calories.html"
    },
    {
      "source": "/blog/daily-calories-to-lose-weight",
      "destination": "/prerender/blog/daily-calories-to-lose-weight.html"
    },
    {
      "source": "/faq",
      "destination": "/prerender/faq.html"
    },
    {
      "source": "/engine",
      "destination": "/prerender/engine.html"
    },
    {
      "source": "/screens",
      "destination": "/prerender/screens.html"
    },
    {
      "source": "/privacy",
      "destination": "/prerender/privacy.html"
    },
    {
      "source": "/partners",
      "destination": "/prerender/partners.html"
    },
    {
      "source": "/((?!.*\\.[a-zA-Z0-9]{2,5}).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
